<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SecchiServicios.App.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SecchiServicios.App.Windows.ConfirmarReemision"
        x:DataType="vm:ConfirmarReemisionViewModel"
        Background="{DynamicResource PrimaryBackgroundGradient}"
        Title="ConfirmarReemision">
    <Grid RowDefinitions="Auto, *, Auto" Margin="20">
        <DataGrid Grid.Row="1" AutoGenerateColumns="False" SelectionMode="Extended"
                  CanUserResizeColumns="True" CanUserSortColumns="True"
                  ItemsSource="{Binding Recibos}"
                  SelectionChanged="DataGrid_OnSelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente.Nombre}"></DataGridTextColumn>
                <DataGridTextColumn Header="Servicio" Binding="{Binding ProductoServicio.Nombre}"></DataGridTextColumn>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}"></DataGridTextColumn>
                <DataGridTextColumn Header="Monto" Binding="{Binding Total}"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        
        
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center" Margin="0 20 0 0">
            <TextBlock Text="Fecha Reemision:" FontWeight="Bold" VerticalAlignment="Top" Foreground="{DynamicResource PrimaryButtonForeground}"></TextBlock>
            <DatePicker SelectedDate="{Binding FechaReemision}"
                        SelectedDateChanged="DatePicker_OnSelectedDateChanged"
                        MonthFormat="MM" DayFormat="dd" YearFormat="yyyy"/>
            
            <Button Classes="Normal" Command="{Binding ConfirmCommand}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <Label Classes="icon" Content="&#xEadc;" FontSize="30" Padding="5 0 0 0" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                    <Label Classes="h3" Content="Confirmar" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                </StackPanel>
            </Button>
            
            <Button Classes="danger" Command="{Binding QuitarRecibosCommand}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <Label Classes="icon danger" Content="&#xe4A6;" FontSize="30" Padding="5 0 0 0" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                    <Label Classes="h3 danger" Content="Borrar Recibo" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
