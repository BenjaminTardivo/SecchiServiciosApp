<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SecchiServicios.App.ViewModels.CrearViewModels"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="560"
        x:Class="SecchiServicios.App.Windows.CrearWindows.CrearReciboWindow"
        xmlns:converters="clr-namespace:SecchiServicios.App.Converters"
        Width="500" Height="300"
        Background="{DynamicResource PrimaryBackgroundGradient}"
        x:DataType="vm:CrearReciboViewModel"
        Title="CrearReciboWindow">
    <ScrollViewer>
        <Border BorderBrush="{DynamicResource PrimaryButtonForeground}" Margin="20" BorderThickness="3" CornerRadius="6">
            <StackPanel Margin="20" Spacing="12">
                <TextBlock Text="Crear Nuevo Recibo" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryButtonForeground}"/>
                <AutoCompleteBox Watermark="Cliente..." ItemsSource="{Binding Clientes}" 
                                 SelectedItem="{Binding SelectedCliente}"
                                 FilterMode="Contains"
                                 ValueMemberBinding="{Binding Nombre}"/>
                <AutoCompleteBox Watermark="Producto/Servicio" 
                                 ItemsSource="{Binding Productos}" 
                                 SelectedItem="{Binding SelectedProductoServicio}"
                                 FilterMode="Contains"
                                 ValueMemberBinding="{Binding Nombre}"/>
                
                <Button Classes="alt" VerticalAlignment="Bottom" Margin="0 40 0 0" Command="{Binding CrearReciboCommand}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <Label Classes="icon alt" Content="&#xe2f8;" FontSize="30" Padding="5 0 0 0" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                        <Label Classes="h3 alt" Content="Crear" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
